# RoadwiseFleet staging environment — KEY NAMES ONLY.
#
# Host path: /opt/roadwisefleet/staging/.env
# Install:   sudo install -m 0600 -o root -g root staging.env.example \
#              /opt/roadwisefleet/staging/.env   # then fill in the values
#
# This file is the FORM, not the secret store. The real file is 0600 and is
# gitignored; never commit values, never paste them into issues/PRs/logs. The
# deployer sources this file and never echoes it.
#
# Staging must be a DIFFERENT database from production. The pilot Postgres
# container can host both databases; create the staging one once:
#   sudo podman exec -it roadwise-pg psql -U postgres -c 'CREATE DATABASE roadwisefleet_staging;'
# (role/database names here are placeholders — use what the host actually has.)

PORT=8081
HOST=127.0.0.1

# Same Postgres server (127.0.0.1:5432), different database name than production.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/roadwisefleet_staging
REDIS_URL=redis://127.0.0.1:6379

# Distinct from production: rotating these must not invalidate pilot tokens.
AUTH_SECRET=
ADMIN_TOKEN=

# Used by the smoke test (apps/api/scripts/smoke-pilot.ts) and the seeder.
SEED_PASSWORD=
