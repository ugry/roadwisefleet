# RoadwiseFleet — auth email sender settings (board eila/tasks#124).
#
# This file is the FORM, not the secret store. It carries KEY NAMES ONLY.
# The real file lives on elilavps2 at:
#
#   /etc/roadwisefleet/auth-email.env      mode 0600, owner root, group root
#
# Install (as root, values typed on the host — never copied from git, an email
# or an agent workspace):
#
#   sudo install -m 0600 -o root -g root /dev/null /etc/roadwisefleet/auth-email.env
#   sudo editor /etc/roadwisefleet/auth-email.env
#
# The API unit reads it as a second, root-only EnvironmentFile:
#
#   EnvironmentFile=-/etc/roadwisefleet/auth-email.env
#
# systemd (PID 1) reads the file as root and passes the values in the
# service's environment, so mode 0600 root:root works while the API still runs
# as `debian`. Nothing here is ever committed with a value.
#
# Sender: no-reply@elilaltd.com — submission, implicit TLS, port 465.
# Runbook: infra/auth-email.md
# Checker: infra/scripts/auth-email-send.sh (--check / --send / --check-repo)

# Submission host for Stalwart on elilavps1 (verified from the MX record).
AUTH_EMAIL_SMTP_HOST=mail.elilaltd.com

# 465 = implicit TLS (smtps). Do not use 25/587 for this credential.
AUTH_EMAIL_SMTP_PORT=465

# The mailbox the orchestrator creates. Not a personal mailbox.
AUTH_EMAIL_SMTP_USER=no-reply@elilaltd.com

# The SMTP password for the mailbox above. Fill in ON THE HOST ONLY.
AUTH_EMAIL_SMTP_PASS=

# Envelope/header From for auth mail. Address only, no display name.
AUTH_EMAIL_FROM=no-reply@elilaltd.com
