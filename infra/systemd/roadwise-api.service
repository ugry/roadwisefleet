# Reference copy — RoadwiseFleet pilot API unit on elilavps2.
#
# Mirror of the live /etc/systemd/system/roadwise-api.service
# (mode 0644, root:root). This is a value-free reference template for review
# and restore; it is NOT applied by CI and changing it does not change the
# running unit.
#
# No credential values appear here. The service reads secrets from the
# EnvironmentFile below (mode 0600, debian:debian, outside the repo).
#
# Authoritative copy: the host file. Transcribed from the verified unit facts
# and live `systemctl status` output (the sandbox cannot read /etc directly).
#
# Provenance of the ordering/type/environment directives (After=, Wants=,
# Type=, Environment=): the live unit was read by the overseer over SSH `sudo`
# (2026-09-14, ref 12). This sandbox cannot read /etc, so those directives are
# reproduced from that read, not independently re-read here. Independently
# confirmed read-only this run: unit is `enabled`, service `active (running)`,
# and the running command matches ExecStart below.

[Unit]
Description=RoadwiseFleet pilot API (elilavps2)
After=network-online.target roadwise-pg.service roadwise-redis.service
Wants=network-online.target
Requires=roadwise-pg.service

[Service]
Type=simple
User=debian
Group=debian
Environment=HOME=/home/debian
WorkingDirectory=/opt/roadwisefleet/api
EnvironmentFile=/opt/roadwisefleet/api/.env
ExecStart=/usr/local/bin/pnpm --filter @roadwisefleet/api start
Restart=always
RestartSec=5
NoNewPrivileges=true
# PROPOSED, NOT LIVE (board #46, finding U1): 0640 files / 0750 dirs for stored
# POD/eCMR documents. The app now requests those modes itself
# (apps/api/src/documents.js); UMask=0027 is defence in depth and also covers the
# Postgres/Redis data where they are rootless. Add only in the owner-approved
# window together with the upload-directory move — infra/uploads.md §4.
# UMask=0027

[Install]
WantedBy=multi-user.target
