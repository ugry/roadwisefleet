# Ready-to-apply artifact — RoadwiseFleet pilot disk/uploads headroom check (board eila/tasks#46).
#
# NOT installed by CI. Installing this on elilavps2 is a host change that needs
# owner approval + host access; see infra/uploads.md §6.
#
# Install to /etc/systemd/system/pilot-disk-check.service (mode 0644).
# No credential values appear here.
#
# board #62: UPLOAD_DIR default is the POST-MOVE path (/var/lib/roadwisefleet/
# uploads). The pre-move /opt/roadwisefleet/api/var/uploads is an abandoned
# directory since the B1 host apply — pointing this check back at it would
# silently report headroom and permissions for a directory nothing writes to.
# EnvironmentFile= lets the path be overridden in one place (settings from that
# file win over Environment=), so it cannot drift again.

[Unit]
Description=RoadwiseFleet pilot disk headroom + uploads permission check (board #46)
Documentation=https://github.com/ugry/roadwisefleet/blob/main/infra/uploads.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pilot-disk-check.sh
# Alert routing + thresholds + the uploads path. The path can be overridden
# without editing this unit — /etc/roadwisefleet/uploads.env (0600, root) is
# optional and its settings win over Environment=. Do not edit that file from
# the repo; the value is host state, not config-as-code. See infra/uploads.md §4.
EnvironmentFile=-/etc/roadwisefleet/uploads.env
Environment=ALERT_MAIL=ugur@elilaltd.com
Environment=UPLOAD_DIR=/var/lib/roadwisefleet/uploads
Environment=WARN_PCT=80
Environment=CRIT_PCT=90
Environment=MIN_FREE_MB=2048
StateDirectory=pilot-disk-check
# A failed check is a signal, not a crash loop: the timer schedules the next try.
Restart=no
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
