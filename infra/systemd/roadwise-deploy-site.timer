# RoadwiseFleet — site deploy timer (elilavps2)
#
# Host path: /etc/systemd/system/roadwise-deploy-site.timer
# Runbook:   infra/deploy.md §10  (board task eila/tasks#31, re-scoped 2026-09-23)
#
# READY-TO-APPLY ARTIFACT — not installed.
#
# Pull model: every 5 minutes the host asks "is there a newer CI-green commit on
# main?" and deploys it straight to the live pilot if so. Merge -> live site with
# no human action, with no host credential stored in GitHub and no public deploy
# endpoint. 5 minutes (not 1) keeps the unauthenticated GitHub API use at ~12
# requests/hour and still satisfies "merge -> deployed within one deploy window".

[Unit]
Description=Poll main every 5 minutes and deploy to the live pilot site
Documentation=file:/opt/roadwisefleet/api/infra/deploy.md

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=roadwise-deploy-site.service

[Install]
WantedBy=timers.target
