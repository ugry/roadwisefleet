flowchart TD
    classDef entry fill:#e7f5ff,stroke:#1971c2,color:#000
    classDef menu fill:#f8f9fa,stroke:#868e96,color:#000
    classDef dec fill:#fff3bf,stroke:#e8590c,color:#000
    classDef act fill:#d0ebff,stroke:#1971c2,color:#000
    classDef ok fill:#b2f2bb,stroke:#2b8a3e,color:#000
    classDef warn fill:#ffe3e3,stroke:#c92a2a,color:#000
    classDef money fill:#e5dbff,stroke:#5f3dc4,color:#000

    %% ================= STAGE 0 — ENTRY =================
    subgraph ENTRY["STAGE 0 — How a customer arrives"]
        E1["Web portal<br/>roadwisefleet.com/book"]:::entry
        E2["WhatsApp — send the load as a message"]:::entry
        E3["Tracking / POD link from a fleet or solo driver<br/>(no account needed)"]:::entry
        E4["Invite / referral from a partner company"]:::entry
        E5["API / ERP integration — B2B account"]:::entry
    end

    E1 --> D_ACCT
    E2 --> WA_BOT["WhatsApp bot asks for pickup, delivery,<br/>cargo, date — creates Order draft"]:::act
    E3 --> GUEST_TRACK["Guest tracking page<br/>live map + ETA + documents (no login)"]:::act
    E4 --> D_ACCT
    E5 --> API_KEY["API key + sandbox<br/>POST /v1/orders"]:::act
    API_KEY --> ORDER
    GUEST_TRACK --> CTA_ACCT{"Create an account<br/>to book loads?"}:::dec
    CTA_ACCT -->|"yes"| REG
    CTA_ACCT -->|"no, just watching this one"| GUEST_TRACK

    D_ACCT{"Already have<br/>an account?"}:::dec
    D_ACCT -->|"yes"| SIGNIN["Sign in<br/>email+password / SSO / phone OTP"]:::act
    D_ACCT -->|"no"| D_NEED{"What do I need?"}:::dec
    D_NEED -->|"book a shipment"| REG
    D_NEED -->|"I am a carrier / solo driver"| X_CARRIER["Go to Hauling Market signup<br/>(see Solo Driver flow / Fleet flow)"]:::warn
    D_NEED -->|"I run my own trucks"| X_FLEET["Go to Fleet Manager signup<br/>(see Fleet Manager flow)"]:::warn
    D_NEED -->|"just track one shipment"| GUEST_TRACK

    subgraph REGISTRATION["Registration — 2 minutes, no paperwork"]
        REG["Sign up: name, company (optional),<br/>email, phone"]:::act --> OTP["Verify phone OTP + email link"]:::act
        OTP --> PROFILE["Company profile: billing address,<br/>VAT / TIN, default payment terms"]:::act
        PROFILE --> PREFS["Notification preferences:<br/>WhatsApp · email · SMS"]:::act
        PREFS --> TEAM["Invite team members<br/>(buyer · finance · viewer roles)"]:::act
    end
    TEAM --> HOME
    SIGNIN --> HOME

    %% ================= STAGE 1 — HOME MENUS =================
    subgraph HOME["STAGE 1 — Customer home (top menu)"]
        M1["① Book a load"]:::menu
        M2["② Shipments — track / history"]:::menu
        M3["③ Documents — POD · eCMR · invoices"]:::menu
        M4["④ Payments — invoices · credit"]:::menu
        M5["⑤ My carriers — partners · rate cards"]:::menu
        M6["⑥ Account — addresses · team · API · prefs"]:::menu
        M7["⑦ Support — help · claims · chat"]:::menu
    end

    M1 --> BOOK
    M2 --> TRACK
    M3 --> DOCS
    M4 --> PAY
    M5 --> CARRIERS
    M6 --> ACCOUNT
    M7 --> SUPPORT

    %% ================= STAGE 2 — BOOK A LOAD =================
    subgraph BOOK["STAGE 2 — Book a load (all four ways in one form)"]
        F1["Route: pickup + delivery,<br/>+ add stops, saved addresses"]:::act
        F2["Cargo: type · weight · dims · pallets · quantity"]:::act
        F3["Equipment: curtainsider · reefer · flatbed ·<br/>box · tanker · tail-lift · ADR"]:::act
        F4["Dates: load-ready · deliver-by ·<br/>time windows · flexible ±"]:::act
        F5["Special: reefer temp · customs T1/TIR ·<br/>loading help · appointment needed"]:::act
        F6["Photos / notes / documents to attach"]:::act
        F7["Pricing mode: instant price ·<br/>request quotes · set a budget"]:::act
        F8["Who pays + how: me · consignee · third party;<br/>card · SEPA · on account · escrow"]:::act
        F9["Insurance value + special instructions"]:::act
        F1 --> F2 --> F3 --> F4 --> F5 --> F6 --> F7 --> F8 --> F9
    end
    F9 --> CHOOSE

    %% ================= STAGE 3 — CHOOSE SUPPLY =================
    CHOOSE{"How do I want<br/>to ship this?"}:::dec
    CHOOSE -->|"① find a FLEET company"| A_START
    CHOOSE -->|"② find a SOLO driver"| B_START
    CHOOSE -->|"③ auto-match — show me the best of both"| C_START
    CHOOSE -->|"④ use my own saved carrier"| D_START
    CHOOSE -->|"⑤ recurring / contract volume"| E_START
    CHOOSE -->|"⑥ I have my own trucks"| X_FLEET

    subgraph FLEET_PATH["Path ① — Choose a fleet (companies, 2–200 trucks)"]
        A_START["Directory of verified fleets<br/>filter: lane · equipment · rating · ETA · price band"]:::act
        A1["or Broadcast request to matching fleets"]:::act
        A_START --> A2["Fleet profile: verification badge, ratings,<br/>trucks, lanes, insurance, response time"]:::act
        A1 --> A2
        A2 --> A3["Offers arrive: instant rate-card price<br/>or company bid (price + ETA + truck)"]:::act
    end

    subgraph SOLO_PATH["Path ② — Choose a solo driver (owner-operator)"]
        B_START["Beacon board: who is empty where,<br/>heading where, available from when"]:::act
        B1["or Broadcast request to verified solo drivers"]:::act
        B_START --> B2["Driver profile: verified docs, truck specs,<br/>ratings, completed loads, current position"]:::act
        B1 --> B2
        B2 --> B3["Driver offers / bids<br/>(price, ETA to pickup, note)"]:::act
    end

    subgraph AUTO_PATH["Path ③ — Auto-match"]
        C_START["Engine ranks supply by: price · ETA ·<br/>rating · verification · CO2 · reliability"]:::act
        C_START --> C1["3 best options shown — fleet and solo mixed"]:::act
    end

    subgraph OWN_PATH["Path ④ — My own carrier"]
        D_START["Pick from My carriers<br/>(saved fleet / solo / off-platform partner)"]:::act
        D_START --> D1{"Carrier registered<br/>on RoadwiseFleet?"}:::dec
        D1 -->|"yes"| D2["Direct booking request → they accept"]:::act
        D1 -->|"no — off-platform"| D3["Send them a job link by WhatsApp / SMS<br/>(see Off-platform flow)"]:::act
    end

    subgraph CONTRACT_PATH["Path ⑤ — Recurring / contract"]
        E_START["Agreed rate card per lane; weekly / daily schedule"]:::act
        E_START --> E1["Book series of loads;<br/>assign dedicated fleet or driver"]:::act
    end

    A3 --> CP1
    B3 --> CP1
    C1 --> CP1
    D2 --> CONFIRM
    D3 --> CONFIRM
    EC1 --> CONFIRM

    %% ================= STAGE 4 — COMPARE + AWARD =================
    subgraph COMPARE_STEP["STAGE 3b — Compare offers (always side by side)"]
        CP1["Columns: price · pickup ETA · delivery ETA ·<br/>rating · truck · verification · cancellation terms"]:::act
        CP2["Chat / negotiate inside the platform<br/>(counter-offers become structured cards)"]:::act
        CP3["Check: insurance valid, ADR ok,<br/>temperature capable, customs ready"]:::act
        CP1 --> CP2 --> CP3
    end
    CP3 --> AWARD{"Award the load?"}:::dec
    AWARD -->|"not yet — wait / get more offers"| CP1
    AWARD -->|"decline all"| CANCEL_EMPTY["Order stays open or closes<br/>— you can repost later"]:::warn
    AWARD -->|"award it"| CONFIRM["Confirm booking:<br/>price · dates · payment method"]:::act
    CONFIRM --> PAYMODE{"Payment method"}:::dec
    PAYMODE -->|"escrow / pay now"| PM1["Money held by platform;<br/>released to carrier on POD"]:::money
    PAYMODE -->|"on account — credit terms"| PM2["Checked against credit status:<br/>OK · WATCH · BLOCKED"]:::money
    PAYMODE -->|"pay on delivery"| PM3["Carrier invoices after POD"]:::money
    PM1 --> ORDER
    PM2 --> ORDER
    PM3 --> ORDER
    ORDER["ORDER CONFIRMED<br/>Trip created, driver assignment pending"]:::ok --> TRACK

    %% ================= STAGE 5 — TRACK =================
    subgraph TRACK_STEP["STAGE 4 — Shipments: track and communicate"]
        T1["Live map + ETA, truck position"]:::act
        T2["Milestone timeline: Booked → Assigned →<br/>At pickup → Loaded → In transit → Arrived → Delivered"]:::act
        T3["Share a tracking link with your consignee<br/>(no account needed)"]:::act
        T4["Chat with dispatcher / driver;<br/>auto-translation"]:::act
        T5["Change request: new date · new address ·<br/>extra stop → carrier approves or declines"]:::act
        T6["Delay / exception alerts<br/>+ reason + new ETA"]:::warn
        T7["Cancel: free before vehicle assigned,<br/>fee after (policy shown up front)"]:::warn
        T1 --> T2 --> T3 --> T4 --> T5 --> T6 --> T7
    end
    T7 --> DV1

    %% ================= STAGE 6 — DELIVERY + DOCS =================
    subgraph DELIVERY["STAGE 5 — Delivery, proof and rating"]
        DV1["Driver arrives → your consignee signs<br/>or the driver captures e-signature"]:::act
        DV2["POD photo + signature uploaded<br/>(GPS + timestamp)"]:::act
        DV3["eCMR / CMR / customs documents issued<br/>into your Document archive"]:::act
        DV4["You get a notification:<br/>delivered + documents ready"]:::ok
        DV5["Rate the driver and the company<br/>(1–5 stars + comment)"]:::act
        DV6{"Something wrong?"}:::dec
        DV7["Open a claim: damage · shortage · late —<br/>photos, statement, resolution target"]:::warn
        DV1 --> DV2 --> DV3 --> DV4 --> DV5 --> DV6
        DV6 -->|"no, all good"| CLOSED["Shipment closed<br/>repeat booking offered"]:::ok
        DV6 -->|"yes"| DV7
        DV7 --> DV8["Resolution: credit note · insurance ·<br/>carrier agreement — tracked to closure"]:::warn
    end

    %% ================= STAGE 7 — PAY =================
    subgraph PAY_STEP["STAGE 6 — Payments"]
        P1["Invoice auto-built from POD:<br/>freight + accessorials (waiting time etc.)"]:::money
        P2["Pay online: card · SEPA · bank transfer"]:::money
        P3["Credit terms status:<br/>net 7 / 14 / 30 — due date + reminders"]:::money
        P4["Receipts and payment history; download PDFs"]:::money
        P5["Dispute an invoice line → carrier review"]:::warn
        P6["Export to your accounting / ERP"]:::money
        P1 --> P2 --> P3 --> P4 --> P5 --> P6
    end

    %% ================= STAGE 8 — RETAIN =================
    subgraph RETAIN["STAGE 7 — Come back (the habit loop)"]
        R1["Save addresses and routes"]:::act
        R2["Favorite carriers → one-tap rebook"]:::act
        R3["Repeat a past shipment in 2 clicks"]:::act
        R4["Rate cards for your regular lanes"]:::act
        R5["Recurring schedules — weekly / monthly"]:::act
        R6["API keys for ERP: orders in, statuses out"]:::act
        R1 --> R2 --> R3 --> R4 --> R5 --> R6
    end

    %% ================= SMALL FIRM VARIANT =================
    subgraph SMALLFIRM["Variant — Small firm / infrequent shipper (Hauling Market light)"]
        SF1["One account, one screen:<br/>Post a load"]:::entry
        SF2["Form: route · cargo · date · equipment · price"]:::act
        SF3["Broadcast to verified fleets AND solo drivers<br/>within the hour"]:::act
        SF4["Compare 3–6 offers → award → track"]:::act
        SF5["Pay per load (no subscription)<br/>or on account once trusted"]:::money
        SF6["Company profile + ratings<br/>so carriers trust you back"]:::act
        SF1 --> SF2 --> SF3 --> SF4 --> SF5 --> SF6
    end
    SF1 -.->|"same backend<br/>one Order object"| ORDER
