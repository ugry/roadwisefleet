{
  "name": "roadwisefleet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @roadwisefleet/api dev",
    "test": "pnpm --filter @roadwisefleet/api test",
    "db:generate": "pnpm --filter @roadwisefleet/api db:generate",
    "db:migrate": "pnpm --filter @roadwisefleet/api db:migrate",
    "db:status": "pnpm --filter @roadwisefleet/api db:status",
    "db:seed": "pnpm --filter @roadwisefleet/api db:seed",
    "smoke": "pnpm --filter @roadwisefleet/api smoke",
    "deploy": "./deploy.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  }
}
