{
  "name": "@roadwisefleet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --test src/",
    "test:router": "tsx --test test/track-router.test.ts test/driver-pwa.test.ts test/app-shell.test.ts test/trips-list.test.ts test/user-payload.test.ts test/dashboard.test.ts test/delivery-timestamps.test.ts test/trip-assign.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "tsx scripts/seed-pilot.ts",
    "db:reset": "tsx scripts/seed-pilot.ts --reset",
    "smoke": "tsx scripts/smoke-pilot.ts",
    "handoff": "tsx scripts/waitlist-handoff.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
